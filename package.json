{
  "name": "kortivai",
  "version": "0.1.0",
  "description": "KortivAI - an open-source terminal AI coding agent",
  "type": "module",
  "license": "MIT",
  "bin": {
    "kortivai": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-isolation=none --test \"tests/**/*.test.ts\"",
    "test:e2e": "node --experimental-test-isolation=none --test \"tests/e2e/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "diff": "^8.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "kortivai",
    "opencode"
  ]
}
